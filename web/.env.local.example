# Neon-Postgres (kommt automatisch aus der Vercel-Neon-Integration)
DATABASE_URL=postgres://...

# Auth.js
AUTH_SECRET=mit `npx auth secret` generieren
AUTH_GOOGLE_ID=...apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-...

# Magic-Link (aktiv sobald Resend-Domain verifiziert)
# AUTH_RESEND_KEY=re_...
# EMAIL_FROM=login@deine-domain.at
# NEXT_PUBLIC_MAGIC_LINK=1

# Admin-Accounts (Komma-getrennt) - serverseitig durchgesetzt
ADMIN_EMAILS=admin@deine-domain.at
NEXT_PUBLIC_ADMIN_EMAILS=admin@deine-domain.at

# Statische Daten (items.json + thumbs)
NEXT_PUBLIC_DATA_URL=https://clemensjl.github.io/kina-search

# ---------------------------------------------------------------------------
# Provisionskennungen der Einkaufs-Agenten (siehe lib/affiliate.ts)
#
# Die sechs aktiven Kennungen stehen direkt in lib/affiliate.ts, weil eine
# Referral-Kennung ohnehin sichtbar im Ziel-Link steht und so auf jeder
# Umgebung ohne Zusatzkonfiguration wirkt. Die Variablen hier sind nur zum
# Ueberschreiben da - normalerweise braucht man sie nicht.
#
# Zwei Schreibweisen:
#   NEXT_PUBLIC_AFF_LITBUY=meinkuerzel             nutzt den Parameter aus affiliate.ts
#   NEXT_PUBLIC_AFF_LITBUY=inviteCode=meinkuerzel  Parametername mit ueberschrieben
#
# Sonderwert "off" schaltet einen Agenten ab. Ein leerer Wert tut das NICHT,
# damit ein versehentlich geleertes Feld in der Vercel-Oberflaeche keinen
# stillen Umsatzausfall erzeugt.
#
# NEXT_PUBLIC_* landet im Client-Bundle. Kein Secret hier ablegen.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_AFF_LITBUY=
# NEXT_PUBLIC_AFF_SUPERBUY=
# NEXT_PUBLIC_AFF_SUGARGOO=
# NEXT_PUBLIC_AFF_CSSBUY=
# NEXT_PUBLIC_AFF_JOYAGOO=
# NEXT_PUBLIC_AFF_HIPOBUY=
