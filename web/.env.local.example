# Neon-Postgres (kommt automatisch aus der Vercel-Neon-Integration)
DATABASE_URL=postgres://...

# Auth.js
AUTH_SECRET=mit `npx auth secret` generieren
AUTH_GOOGLE_ID=...apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-...

# Magic-Link (aktiv sobald Resend-Domain verifiziert)
# AUTH_RESEND_KEY=re_...
# EMAIL_FROM=login@deine-domain.at
# NEXT_PUBLIC_MAGIC_LINK=1

# Admin-Accounts (Komma-getrennt) - serverseitig durchgesetzt
ADMIN_EMAILS=jele.clemens@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=jele.clemens@gmail.com

# Statische Daten (items.json + thumbs)
NEXT_PUBLIC_DATA_URL=https://clemensjl.github.io/kina-search

# ---------------------------------------------------------------------------
# Provisionskennungen der Einkaufs-Agenten (siehe lib/affiliate.ts)
#
# Leer oder nicht gesetzt = Links bleiben exakt wie ohne Provisionsprogramm.
# Sobald mindestens eine Kennung gesetzt ist, blendet die Oberflaeche automatisch
# die Kennzeichnung ein (Hinweis bei den Agenten-Links + Satz im Fussbereich).
#
# Zwei Schreibweisen:
#   NEXT_PUBLIC_AFF_KAKOBUY=meinkuerzel           Default-Parameter aus affiliate.ts
#   NEXT_PUBLIC_AFF_KAKOBUY=affcode=meinkuerzel   Parametername selbst festlegen
#
# Die Default-Parameternamen sind nicht einzeln im Partnerprogramm verifiziert.
# Vor dem Scharfschalten je Agent im Partner-Dashboard pruefen; weicht der
# Parameter ab, die "param=code"-Form verwenden.
# NEXT_PUBLIC_* landet im Client-Bundle - das ist bei Provisionslinks systembedingt
# so, die Kennung steht ohnehin sichtbar im Ziel-Link. Kein Secret hier ablegen.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_AFF_LITBUY=
# NEXT_PUBLIC_AFF_KAKOBUY=
# NEXT_PUBLIC_AFF_ACBUY=
# NEXT_PUBLIC_AFF_MULEBUY=
# NEXT_PUBLIC_AFF_OOPBUY=
# NEXT_PUBLIC_AFF_HOOBUY=
# NEXT_PUBLIC_AFF_JOYAGOO=
# NEXT_PUBLIC_AFF_USFANS=
# NEXT_PUBLIC_AFF_SUPERBUY=
# NEXT_PUBLIC_AFF_SUGARGOO=
# NEXT_PUBLIC_AFF_CSSBUY=
# NEXT_PUBLIC_AFF_ALLCHINABUY=
# NEXT_PUBLIC_AFF_ORIENTDIG=
# NEXT_PUBLIC_AFF_LOVEGOBUY=
# NEXT_PUBLIC_AFF_OOTDBUY=
# NEXT_PUBLIC_AFF_HIPOBUY=
# NEXT_PUBLIC_AFF_PONYBUY=
# NEXT_PUBLIC_AFF_LOONGBUY=
# NEXT_PUBLIC_AFF_ITAOBUY=
# NEXT_PUBLIC_AFF_BASETAO=
# NEXT_PUBLIC_AFF_EASTMALLBUY=
